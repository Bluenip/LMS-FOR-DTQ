{
  "name": "de-tu-quy-lms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/*.{ts,mjs}\" next.config.ts playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/*.{ts,mjs}\" next.config.ts playwright.config.ts",
    "test:integration": "node scripts/integration-test.mjs",
    "storage:prune": "node --env-file-if-exists=.env --import tsx scripts/prune-storage.ts",
    "storage:backup": "node scripts/backup-objects.mjs",
    "notifications:prune": "node --env-file-if-exists=.env --import tsx scripts/prune-notifications.ts",
    "account:create-teacher": "node --env-file-if-exists=.env --import tsx scripts/create-teacher.ts",
    "account:grant-admin": "node --env-file-if-exists=.env --import tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@prisma/client": "6.19.0",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.20.0"
    }
  }
}
