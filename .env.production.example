# Copy to .env.production and fill these values before running production Compose.
# Use a random hexadecimal PostgreSQL password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_URL=https://lms.example.com

# The host port is bound to loopback for the existing tunnel/reverse proxy.
LMS_PORT=3000
LMS_IMAGE=lms-dtq:local

# Optional: required to upload documents or videos.
# The endpoint used by signed URLs must also be reachable from user browsers.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
