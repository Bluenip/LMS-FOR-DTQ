# Copy to .env.production and fill these values before running production Compose.
# Use a random hexadecimal PostgreSQL password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_URL=https://lms.example.com

# The host port is bound to loopback for the existing tunnel/reverse proxy.
LMS_PORT=3000
LMS_IMAGE=lms-dtq:local
# true when the app is only reachable through your reverse proxy / Cloudflare Tunnel (default).
# With false every client shares one login rate-limit bucket per email.
TRUST_PROXY_HEADERS=true

# Optional: required to upload documents or videos.
# The endpoint used by signed URLs must also be reachable from user browsers.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google Drive video hosting (docs/GOOGLE_DRIVE.md). DRIVE_ENCRYPTION_KEY: 32+ random characters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DRIVE_ENCRYPTION_KEY=
# Minutes between clean-ups of orphaned Drive files (0 disables).
DRIVE_PRUNE_INTERVAL_MINUTES=60
