# Leave DATABASE_URL empty to use the local, persistent demonstration dataset.
# PostgreSQL is used automatically when DATABASE_URL is set.
DATABASE_URL=
SESSION_SECRET=
APP_URL=http://localhost:3000

# Accounts are issued by administrators. Public signup/email recovery are disabled.
# No SMTP configuration is required for login, admin management or profile changes.
# Production demo accounts stay disabled unless explicitly enabled for isolated tests.
ALLOW_DEMO_ACCOUNTS=false
TRUST_PROXY_HEADERS=false

# Amazon S3 or Cloudflare R2; documents pass through the API, videos upload directly.
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3: leave endpoint empty and set the AWS region.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local S3 emulator, for development/tests only (docker compose --profile storage up -d).
# Bucket lms is created automatically. There is no admin console.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=lms
# S3_ACCESS_KEY_ID=S3RVER
# S3_SECRET_ACCESS_KEY=S3RVER
